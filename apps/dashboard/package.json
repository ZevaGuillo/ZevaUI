{
  "name": "@zevaui/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@zevaui/audit": "workspace:*",
    "@zevaui/components": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build-release-log.ts && next build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:local": "tsx --env-file=../../.env.local scripts/migrate.ts",
    "export:registry": "tsx scripts/export-registry.ts"
  }
