# Copy to .env.local and fill in. `.env.local` is git-ignored; this template
# carries names and shapes only, never a value.
#
# Only apps/dashboard reads these. The published packages (tokens, components,
# constraints, audit) are build-time and tenant-agnostic -- they read no
# environment at all, by RNF-08.

# ---------------------------------------------------------------------------
# DATABASE_URL -- required by: db:migrate, the API routes, the panel pages
# ---------------------------------------------------------------------------
# Standard Postgres connection string. D2 forbids provider SDKs, so this is
# the ONLY provider-coupled thing in the app: swap the string, change host.
#
# On Neon, use the POOLED endpoint (the host containing `-pooler`). Serverless
# functions open one connection per invocation; the direct endpoint exhausts
# the connection limit under load, the pooler is what absorbs it.
#
# Set sslmode explicitly. `pg` currently treats `prefer`, `require` and
# `verify-ca` as `verify-full`, and that changes in pg v9 -- an unpinned mode
# silently weakens once the driver majors.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full

# ---------------------------------------------------------------------------
# REGISTRY_ALLOWED_OWNERS -- required by: POST /api/v1/reports
# ---------------------------------------------------------------------------
# Comma-separated GitHub owners whose repositories may submit reports. Empty
# means nobody can write: the gate is deny-by-default, so an unset value fails
# closed rather than opening the registry to the world.
REGISTRY_ALLOWED_OWNERS=your-github-org

# ---------------------------------------------------------------------------
# REGISTRY_OIDC_AUDIENCE -- required by: POST /api/v1/reports
# ---------------------------------------------------------------------------
# The `aud` claim this registry accepts in a GitHub Actions OIDC token, and it
# is the registry's own URL (D4: audience-per-resource). A consumer requests
# its token with this exact string, so the two must match byte for byte.
#
# Ordering trap: this value IS the deployment URL, which does not exist until
# the first deploy. Deploy once, read the production URL, set this, redeploy.
# Until then writes are rejected -- public reads work regardless.
REGISTRY_OIDC_AUDIENCE=https://your-registry.vercel.app
