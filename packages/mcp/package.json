{
  "name": "@zevaui/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing ZevaUI's design contract: validate themes against the token and contrast rules from agents and editors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZevaGuillo/ZevaUI.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "zevaui-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zevaui/constraints": "workspace:*",
    "@zevaui/tokens": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
