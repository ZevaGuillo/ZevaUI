{
  "name": "@zevaui/components",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./components.manifest.json": "./dist/components.manifest.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-aria-components": "^1.20.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@zevaui/tokens": "workspace:*",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "build": "tsc && panda cssgen --outfile dist/styles.css && node scripts/build-manifest.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run"
  }
}
