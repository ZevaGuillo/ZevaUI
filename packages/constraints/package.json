{
  "name": "@zevaui/constraints",
  "version": "0.2.0",
  "description": "Machine-readable design contract and validateTheme() for ZevaUI: WCAG text (4.5:1/7.0:1) and non-text (3.0:1) contrast enforcement",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZevaGuillo/ZevaUI.git",
    "directory": "packages/constraints"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
